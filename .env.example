# Copia este archivo como .env y completa los valores reales en tu equipo.
# Nunca subas .env ni claves privadas al repositorio.

# Django
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Roboflow
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_VIH_MODEL_ID=proyecto-de-vih/1
ROBOFLOW_SKIN_MODEL_ID=proyecto-de-vih/2
ROBOFLOW_VIH_CLASS_ID=1
ROBOFLOW_SKIN_CLASS_ID=2
ROBOFLOW_DEBUG_LOGS=0

# Sensibilidad anti falsos positivos
ROBOFLOW_MIN_VIH_PX=120
ROBOFLOW_MIN_OVERLAP_PX=40
ROBOFLOW_MIN_RATIO_ALERT=0.8

# Fases 0-100 (% de piel afectada)
ROBOFLOW_FASE_NULA_MAX=1.0
ROBOFLOW_FASE_BAJA_MAX=8.0
ROBOFLOW_FASE_MEDIANA_MAX=20.0
